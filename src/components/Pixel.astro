---
import { PALETTE, SPRITES, type SpriteName } from '../lib/sprites';

interface Props {
  name: SpriteName;
  /** Size of one pixel, in CSS px. */
  scale?: number;
  /** Accessible label. Omit for purely decorative sprites. */
  label?: string;
  class?: string;
}

const { name, scale = 2, label, class: className } = Astro.props;
const rows = SPRITES[name];
const w = Math.max(...rows.map((r) => r.length));
const h = rows.length;

const cells = rows.flatMap((row, y) =>
  [...row].flatMap((c, x) => (PALETTE[c] ? [{ x, y, fill: PALETTE[c] }] : [])),
);
---

<svg
  class:list={['pixelated', 'sprite', className]}
  viewBox={`0 0 ${w} ${h}`}
  width={w * scale}
  height={h * scale}
  role={label ? 'img' : undefined}
  aria-label={label}
  aria-hidden={label ? undefined : 'true'}
  focusable="false"
>
  {cells.map((c) => <rect x={c.x} y={c.y} width="1" height="1" fill={c.fill} />)}
</svg>
