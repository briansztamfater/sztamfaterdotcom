---
import Pixel from './Pixel.astro';
import EmailLink from './EmailLink.astro';
import LangSwitcher from './LangSwitcher.astro';
import { SITE, SOCIALS } from '../site.config';
import { t, type Lang, DEFAULT_LANG } from '../i18n';

interface Props {
  lang?: Lang;
}

const { lang = DEFAULT_LANG } = Astro.props;
const dict = t(lang);

const year = new Date().getFullYear();
const years = year > SITE.since ? `${SITE.since}–${year}` : `${year}`;
---

<footer class="site-footer frame">
  <hr class="dotted" />

  <div class="cols">
    <div class="colophon">
      <p>
        © {SITE.name}<br />
        <span class="muted">{SITE.basedIn} · {years}</span>
      </p>
      <p class="handmade">
        {dict.footer.credits1}<br />
        {dict.footer.credits2}
        <Pixel name="heart" scale={2} class="heart" />
      </p>
      <p
        class="visits ui muted"
        data-visits
        data-first={dict.footer.first}
        data-first-no={dict.footer.firstNo}
        data-back={dict.footer.back}
        data-back-no={dict.footer.backNo}
        hidden
      >
      </p>
    </div>

    <div class="elsewhere">
      <ul class="socials ui" aria-label={dict.a11y.elsewhere}>
        {
          SOCIALS.map((s) => (
            <li>
              <a href={s.href} rel="me">
                {s.label.toLowerCase()}
              </a>
            </li>
          ))
        }
        <li><EmailLink>{dict.footer.email}</EmailLink></li>
      </ul>

      <ul class="badges" aria-label={dict.a11y.badges}>
        <li>
          <a class="badge plain" href="/rss.xml">
            <span class="l">RSS</span><span class="r">feed</span>
          </a>
        </li>
        <li>
          <span class="badge"><span class="l">human</span><span class="r">+ AI</span></span>
        </li>
        <li>
          <span class="badge"><span class="l">zero</span><span class="r">trackers</span></span>
        </li>
        <li>
          <span class="badge" title={dict.footer.anyBrowser}>
            <span class="l">any</span><span class="r">browser</span>
          </span>
        </li>
      </ul>
    </div>
  </div>

  <div class="languages">
    <p class="pixel muted">{dict.footer.languages}</p>
    <LangSwitcher lang={lang} variant="names" />
  </div>
</footer>

<script is:inline>
  (function () {
    // The footer greeting and the homepage counter show the same number: the site-wide
    // visitor number (netlify/functions/hits.mts). One POST per browser session, no cookies,
    // no ids: the server only ever stores a single number. Whether you've been here before
    // is remembered only in your own browser.
    try {
      var el = document.querySelector('[data-visits]');
      var odo = document.querySelector('[data-odometer]');
      var seen = Number(localStorage.getItem('sz:visits') || 0);
      if (!sessionStorage.getItem('sz:counted')) {
        seen += 1;
        localStorage.setItem('sz:visits', String(seen));
        sessionStorage.setItem('sz:counted', '1');
      }
      var show = function (count) {
        var no = count > 0 ? String(count).padStart(6, '0') : '';
        if (odo && no) odo.textContent = no;
        if (el) {
          var d = el.dataset;
          var text = seen > 1 ? (no ? d.backNo : d.back) : no ? d.firstNo : d.first;
          el.textContent = text.replace('{n}', no);
          el.hidden = false;
        }
      };
      var mine = Number(sessionStorage.getItem('sz:visitor') || 0);
      show(mine);
      if (!mine && !sessionStorage.getItem('sz:hit')) {
        sessionStorage.setItem('sz:hit', '1');
        fetch('/api/hits', { method: 'POST' })
          .then(function (r) {
            return r.ok ? r.json() : Promise.reject();
          })
          .then(function (d) {
            sessionStorage.setItem('sz:visitor', String(d.count));
            show(d.count);
          })
          .catch(function () {});
      }
    } catch (e) {}

    console.log(
      '%chi there.%c\nyou opened the console on a personal website. respect.\nthe source is plain html and css, go look around.',
      'font: 600 16px Georgia, serif',
      'font: 12px monospace',
    );
  })();
</script>

<style>
  .site-footer {
    padding-top: 1rem;
    padding-bottom: 3rem;
    font-size: var(--step--1);
    line-height: 1.5;
  }

  .site-footer hr {
    margin: 0 0 1.75rem;
  }

  .cols {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    gap: 1.5rem 3rem;
  }

  .colophon p {
    margin: 0 0 0.9rem;
  }

  .handmade {
    font-family: var(--text);
    font-style: italic;
    font-size: 0.8125rem;
  }

  .handmade :global(.heart) {
    display: inline-block;
    margin-inline-start: 0.3rem;
    vertical-align: -1px;
    animation: beat 2.4s ease-in-out infinite;
  }

  @keyframes beat {
    0%,
    30%,
    100% {
      transform: scale(1);
    }
    10% {
      transform: scale(1.25);
    }
    20% {
      transform: scale(1.1);
    }
  }

  .visits {
    font-size: var(--step--2);
  }

  .elsewhere {
    display: flex;
    flex-direction: column;
    align-items: flex-end;
    gap: 1rem;
  }

  ul {
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .socials {
    display: flex;
    gap: 1rem;
  }

  .badges {
    display: flex;
    flex-wrap: wrap;
    gap: 6px;
    justify-content: flex-end;
  }

  /* 88×31, the only correct badge size */
  .badge {
    display: flex;
    width: 88px;
    height: 31px;
    border: 1px solid var(--ink);
    font-family: var(--pixel);
    font-size: 8px;
    line-height: 1;
    text-transform: uppercase;
    text-decoration: none;
    color: var(--ink);
    background: var(--paper);
    box-shadow:
      inset 1px 1px 0 color-mix(in srgb, var(--paper) 50%, white),
      inset -1px -1px 0 color-mix(in srgb, var(--ink) 25%, transparent);
    user-select: none;
    direction: ltr;
  }

  .badge .l,
  .badge .r {
    display: grid;
    place-items: center;
    padding: 0 4px;
  }

  .badge .l {
    background: var(--ink);
    color: var(--paper);
    min-width: 32px;
  }

  .badge .r {
    flex: 1;
    text-align: center;
  }

  a.badge .l {
    background: var(--accent);
    color: #ffffff;
  }

  a.badge:visited {
    color: var(--ink);
  }

  a.badge:hover {
    transform: translate(-1px, -1px);
    box-shadow: 2px 2px 0 var(--ink);
  }

  .languages {
    margin-top: 2rem;
    padding-top: 0.8rem;
    border-top: 1px dotted var(--line);
  }

  .languages .pixel {
    margin: 0 0 0.5rem;
  }

  @media (max-width: 40rem) {
    .elsewhere {
      align-items: flex-start;
    }

    .badges {
      justify-content: flex-start;
    }
  }
</style>
