---
/** Label ........ value, like a table of contents from 1998. */
import type { NowItem } from '../data/now';
import { t, type Lang, DEFAULT_LANG } from '../i18n';

interface Props {
  items: NowItem[];
  lang?: Lang;
}

const { items, lang = DEFAULT_LANG } = Astro.props;
const tbd = t(lang).now.stillDeciding.replace(/^\(|\)$/g, '');
---

<dl class="now-list">
  {
    items.map((item) => (
      <div class="row">
        <dt>{item.label}</dt>
        <span class="leader" aria-hidden="true" />
        <dd>
          {item.value === null ? (
            <span class="tbd" title={tbd}>…</span>
          ) : item.href ? (
            <a href={item.href}>{item.value}</a>
          ) : (
            item.value
          )}
        </dd>
      </div>
    ))
  }
</dl>

<style>
  .now-list {
    margin: 0;
    font-size: var(--step--1);
  }

  .row {
    display: flex;
    align-items: baseline;
    gap: 0.4rem;
    padding: 0.2rem 0;
  }

  dt {
    font-family: var(--ui);
    font-size: var(--step--1);
    color: var(--ink-2);
    white-space: nowrap;
  }

  .leader {
    flex: 1;
    min-width: 1rem;
    border-bottom: 2px dotted var(--line);
    transform: translateY(-0.3em);
  }

  dd {
    margin: 0;
    text-align: end;
  }

  .tbd {
    color: var(--ink-3);
    cursor: help;
  }
</style>
