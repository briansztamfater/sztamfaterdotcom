---
import { SITE } from '../site.config';
import { OG_WIDTH, OG_HEIGHT, type JsonLd } from '../lib/seo';
import { t, type Lang, LOCALES, OTHER_LANGS, DEFAULT_LANG, localeOf, localePath, splitPath } from '../i18n';

export interface Props {
  /** Which language this page is in. English (the default) lives at the root, others under /<lang>/. */
  lang?: Lang;
  title?: string;
  description?: string;
  /** Absolute or root-relative image URL for social previews. */
  image?: string;
  imageAlt?: string;
  type?: 'website' | 'article';
  publishedTime?: Date;
  /** Articles only: when it was last revised. */
  modifiedTime?: Date;
  /** Articles only: Open Graph section and tags. */
  section?: string;
  tags?: string[];
  /** Up to two label/value pairs that Slack, X and Discord show in link previews. */
  labels?: { label: string; data: string }[];
  noindex?: boolean;
  /** A plain Markdown copy of this page, for AI assistants. */
  markdown?: string;
  /** schema.org structured data for this page. */
  jsonLd?: JsonLd;
  /** Whether this page exists in every language (so hreflang links and the first-visit redirect make sense). */
  translated?: boolean;
}

const { lang = DEFAULT_LANG, title, type = 'website', publishedTime, modifiedTime, section, tags = [], labels = [], noindex = false, jsonLd, markdown, translated = true } = Astro.props;
const dict = t(lang);
const locale = localeOf(lang);
const {
  description = dict.site.description,
  image = '/og/index.png',
  imageAlt = dict.site.imageAlt.replace('{domain}', SITE.domain).replace('{name}', SITE.name),
} = Astro.props;

// Titles: professional content, 2000s punctuation (the `|` separator). Specific part first,
// because search engines cut titles off around 60 characters.
//   home:    Brian Sztamfater | Entrepreneur, Software Engineer, Builder & Author
//   section: Thoughts | Brian Sztamfater
//   thought: <title> | Thoughts | Brian Sztamfater
const roles = dict.site.roles;
const fullTitle = !title
  ? `${SITE.name} | ${roles.slice(0, -1).join(', ')} ${dict.site.and} ${roles.at(-1)}`
  : type === 'article'
    ? `${title} | ${dict.thoughts.title} | ${SITE.name}`
    : `${title} | ${SITE.name}`;
const canonical = new URL(Astro.url.pathname, Astro.site);
const imageUrl = new URL(image, Astro.site);

// The same page in every language, for hreflang and og:locale:alternate.
const { path } = splitPath(Astro.url.pathname);
const alternates = translated ? LOCALES.map((l) => ({ ...l, href: new URL(localePath(l.code, path), Astro.site).href })) : [];
---

<meta charset="utf-8" />
<meta name="viewport" content="width=device-width, initial-scale=1" />
<title>{fullTitle}</title>
<meta name="description" content={description} />
<link rel="canonical" href={canonical} />
<meta name="robots" content={noindex ? 'noindex' : 'index, follow, max-image-preview:large, max-snippet:-1'} />
{alternates.map((l) => <link rel="alternate" hreflang={l.html} href={l.href} />)}
{translated && <link rel="alternate" hreflang="x-default" href={new URL(path, Astro.site).href} />}

{
  lang === DEFAULT_LANG && translated && (
    // First visit only: if the browser prefers one of the other languages, go there. Picking a
    // language from the switcher is remembered (localStorage, this browser only) and wins from then on.
    // Translated pages never redirect, so crawlers and shared links always land where they point.
    <script is:inline set:html={`(function(){try{var L=${JSON.stringify(OTHER_LANGS)},w=localStorage.getItem('sz:lang');if(!w){var ls=navigator.languages||[navigator.language];for(var i=0;i<ls.length;i++){var c=String(ls[i]||'').slice(0,2).toLowerCase();if(c==='en'){w='en';break}if(L.indexOf(c)>=0){w=c;break}}}if(w&&L.indexOf(w)>=0)location.replace('/'+w+location.pathname+location.search+location.hash)}catch(e){}})();`} />
  )
}

<meta name="author" content={SITE.name} />
<meta name="generator" content={Astro.generator} />
<meta name="color-scheme" content="light" />
<meta name="theme-color" content="#eeeecc" />

<link rel="icon" href="/favicon.ico" sizes="48x48" />
<link rel="icon" href="/favicon.svg" type="image/svg+xml" />
<link rel="apple-touch-icon" href="/apple-touch-icon.png" />
<link rel="manifest" href="/site.webmanifest" />
<link rel="author" href="/humans.txt" type="text/plain" />
<link rel="alternate" type="application/rss+xml" title={`${SITE.name}: thoughts`} href={new URL('/rss.xml', Astro.site)} />
<link rel="sitemap" href="/sitemap-index.xml" />
{markdown && <link rel="alternate" type="text/markdown" href={markdown} />}

<meta property="og:type" content={type} />
<meta property="og:site_name" content={SITE.domain} />
<meta property="og:title" content={title ?? SITE.name} />
<meta property="og:description" content={description} />
<meta property="og:url" content={canonical} />
<meta property="og:image" content={imageUrl} />
<meta property="og:image:alt" content={imageAlt} />
<meta property="og:image:width" content={String(OG_WIDTH)} />
<meta property="og:image:height" content={String(OG_HEIGHT)} />
<meta property="og:image:type" content="image/png" />
<meta property="og:locale" content={locale.og} />
{alternates.filter((l) => l.code !== lang).map((l) => <meta property="og:locale:alternate" content={l.og} />)}
{publishedTime && <meta property="article:published_time" content={publishedTime.toISOString()} />}
{publishedTime && <meta property="article:author" content={SITE.name} />}
{modifiedTime && <meta property="article:modified_time" content={modifiedTime.toISOString()} />}
{section && <meta property="article:section" content={section} />}
{tags.map((tag) => <meta property="article:tag" content={tag} />)}

<meta name="twitter:card" content="summary_large_image" />
<meta name="twitter:creator" content="@briansztamfater" />
<meta name="twitter:title" content={title ?? SITE.name} />
<meta name="twitter:description" content={description} />
<meta name="twitter:image" content={imageUrl} />
<meta name="twitter:image:alt" content={imageAlt} />
{
  labels.slice(0, 2).map((l, i) => (
    <>
      <meta name={`twitter:label${i + 1}`} content={l.label} />
      <meta name={`twitter:data${i + 1}`} content={l.data} />
    </>
  ))
}

{jsonLd && <script type="application/ld+json" set:html={JSON.stringify(jsonLd).replace(/</g, '\\u003c')} />}
