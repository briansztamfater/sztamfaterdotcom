---
import type { GetStaticPaths } from 'astro';
import NowView from '../../views/NowView.astro';
import { OTHER_LANGS, type Lang } from '../../i18n';

export const getStaticPaths = (() => OTHER_LANGS.map((lang) => ({ params: { lang } }))) satisfies GetStaticPaths;
const lang = Astro.params.lang as Lang;
---

<NowView lang={lang} />
