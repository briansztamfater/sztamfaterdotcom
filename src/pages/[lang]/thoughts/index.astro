---
import type { GetStaticPaths } from 'astro';
import ThoughtsView from '../../../views/ThoughtsView.astro';
import { OTHER_LANGS, type Lang } from '../../../i18n';

export const getStaticPaths = (() => OTHER_LANGS.map((lang) => ({ params: { lang } }))) satisfies GetStaticPaths;
const lang = Astro.params.lang as Lang;
---

<ThoughtsView lang={lang} />
