---
import Base from '../layouts/Base.astro';
import Pixel from '../components/Pixel.astro';
import { t, parts } from '../i18n';

// Netlify serves this one page for every missing URL, so it's in English, with the
// language links in the header and footer for everyone else.
const dict = t('en');
---

<Base title={dict.notFound.title} description={dict.notFound.description} noindex translated={false}>
  <div class="lost">
    <Pixel name="computer" scale={6} class="icon" />
    <p class="pixel code">{dict.notFound.code}</p>
    <h1>{dict.notFound.heading}</h1>
    <p>
      {
        parts(dict.notFound.body).map((p) =>
          typeof p === 'string' ? p : p.key === 'home' ? <a href="/">{dict.notFound.home}</a> : <a href="/thoughts/">{dict.notFound.thoughts}</a>,
        )
      }
    </p>
  </div>
</Base>

<style>
  .lost {
    max-width: 32rem;
    padding: clamp(2rem, 8vw, 6rem) 0 2rem;
  }

  .lost :global(.icon) {
    margin-bottom: 1.5rem;
    animation: shake 4s ease-in-out infinite;
  }

  @keyframes shake {
    0%,
    90%,
    100% {
      transform: rotate(0);
    }
    92% {
      transform: rotate(-6deg);
    }
    96% {
      transform: rotate(6deg);
    }
  }

  .code {
    font-size: 0.7rem;
    color: var(--accent-ink);
    margin-bottom: 0.6rem;
  }

  h1 {
    font-size: var(--step-3);
    margin-bottom: 1rem;
  }
</style>
