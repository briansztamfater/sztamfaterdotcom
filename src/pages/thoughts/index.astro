---
import Base from '../../layouts/Base.astro';
import { getThoughts, thoughtUrl, excerptOf, isNew, newUntil } from '../../lib/thoughts';
import NewBadge from '../../components/NewBadge.astro';
import { stamp, iso } from '../../lib/dates';
import { SITE } from '../../site.config';
import { graph, identity } from '../../lib/seo';

const thoughts = await getThoughts();

// group by year, newest first
const years = [...new Set(thoughts.map((t) => t.data.date.getUTCFullYear()))];
const byYear = years.map((y) => ({ year: y, items: thoughts.filter((t) => t.data.date.getUTCFullYear() === y) }));
---

<Base
  title="Thoughts"
  description="Things Brian Sztamfater is thinking about, written down before he changes his mind."
  image="/og/thoughts.png"
  jsonLd={graph(
    {
      '@type': 'Blog',
      '@id': `${SITE.url}/thoughts/#blog`,
      name: `${SITE.name}: thoughts`,
      url: `${SITE.url}/thoughts/`,
      author: { '@id': `${SITE.url}/#person` },
      blogPost: thoughts.map((t) => ({ '@id': `${SITE.url}${thoughtUrl(t)}#post` })),
    },
    ...identity(),
  )}
>
  <header class="page-head margin-layout">
    <p class="in-margin kicker ui">~/thoughts</p>
    <h1>Thoughts</h1>
    <p class="lede">
      Things I'm thinking about, written down before I change my mind. Software, AI, games, the internet, and whatever
      else has my attention this week. Newest first. There's an <a href="/rss.xml">RSS feed</a>, if you're one of us.
    </p>
  </header>

  {
    byYear.map(({ year, items }) => (
      <section class="year margin-layout" aria-labelledby={`y${year}`}>
        <h2 id={`y${year}`} class="in-margin year-label pixel">
          {year}
        </h2>
        <ol class="entries">
          {items.map((t) => (
            <li>
              <article>
                <time class="ui" datetime={iso(t.data.date)}>
                  {stamp(t.data.date)}
                </time>
                <h3>
                  <a href={thoughtUrl(t)}>{t.data.title}</a>
                  {isNew(t) && <NewBadge until={newUntil(t)} />}
                </h3>
                <p class="excerpt">{excerptOf(t)}</p>
                <p class="foot ui">
                  <a href={thoughtUrl(t)} class="read" aria-hidden="true" tabindex="-1">
                    read →
                  </a>
                  {t.data.tags.length > 0 && <span class="tags">{t.data.tags.map((tag) => `#${tag}`).join(' ')}</span>}
                </p>
              </article>
            </li>
          ))}
        </ol>
      </section>
    ))
  }

  {thoughts.length === 0 && <p class="muted">Nothing here yet. Soon.</p>}
</Base>

<style>
  .page-head {
    padding: 0.25rem 0 1.5rem;
    border-bottom: 1px solid var(--ink);
    margin-bottom: 2rem;
  }

  .kicker {
    color: var(--ink-2);
    padding-top: 1.1rem;
    margin: 0;
  }

  h1 {
    font-size: var(--step-4);
    color: var(--red);
    letter-spacing: -0.02em;
    line-height: 1;
    margin-bottom: 0.8rem;
  }

  .lede {
    font-size: 0.9375rem;
    color: var(--ink-2);
    margin: 0;
  }

  .year {
    margin-bottom: 2rem;
  }

  .year-label {
    font-size: 0.75rem;
    padding-top: 0.4rem;
    color: var(--accent-ink);
  }

  .entries {
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .entries li + li {
    margin-top: 1.8rem;
  }

  article time {
    display: block;
    color: var(--ink-2);
    margin-bottom: 0.35rem;
  }

  h3 {
    font-size: var(--step-1);
    margin-bottom: 0.4rem;
  }


  .excerpt {
    margin-bottom: 0.5rem;
  }

  .foot {
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem 1.2rem;
    margin: 0;
  }

  .read {
    color: var(--link);
  }

  .tags {
    color: var(--ink-3);
  }

  @media (max-width: 46rem) {
    .kicker {
      padding: 0;
    }
  }
</style>
