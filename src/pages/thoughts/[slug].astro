---
import type { GetStaticPaths } from 'astro';
import ThoughtView from '../../views/ThoughtView.astro';
import { getThoughts, type Thought } from '../../lib/thoughts';

export const getStaticPaths = (async () => {
  const thoughts = await getThoughts();
  return thoughts.map((thought, i) => ({
    params: { slug: thought.id },
    props: { thought, newer: thoughts[i - 1], older: thoughts[i + 1] },
  }));
}) satisfies GetStaticPaths;

interface Props {
  thought: Thought;
  newer?: Thought;
  older?: Thought;
}
---

<ThoughtView lang="en" {...Astro.props} />
