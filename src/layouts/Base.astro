---
import '@fontsource/silkscreen/400.css';
import '../styles/global.css';

import Head, { type Props as HeadProps } from '../components/Head.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { t, localeOf, DEFAULT_LANG } from '../i18n';

type Props = HeadProps & { bodyClass?: string };

const { bodyClass, lang = DEFAULT_LANG, ...head } = Astro.props;
const locale = localeOf(lang);
const dict = t(lang);

const hello = `
<!--
  hi, view-source reader.

  this site was built by a human and an AI, pair-programming.
  the human had the opinions. the AI typed faster.
  if you're reading this, we'd probably get along.
-->`;
---

<!doctype html>
<html lang={locale.html} dir={locale.dir}>
  <head>
    <Head lang={lang} {...head} />
  </head>
  <body class={bodyClass}>
    <Fragment set:html={hello} />
    <a class="skip" href="#content">{dict.a11y.skip}</a>
    <div class="site">
      <Header lang={lang} />
      <main id="content" class="frame" tabindex="-1">
        <slot />
      </main>
      <Footer lang={lang} />
    <script is:inline>
      // Email links (src/components/EmailLink.astro): the real address is only put together when
      // a person reaches for the link (hover, keyboard focus or touch), so it never sits in the HTML.
      document.querySelectorAll('[data-mail-user]').forEach(function (a) {
        var arm = function () {
          a.href = 'mailto:' + a.dataset.mailUser + '@' + a.dataset.mailDomain;
        };
        ['mouseenter', 'focus', 'touchstart'].forEach(function (ev) {
          a.addEventListener(ev, arm, { once: true, passive: true });
        });
      });
      // Language links (src/components/LangSwitcher.astro): picking a language is remembered in
      // this browser only, so the first-visit redirect (src/components/Head.astro) leaves you alone.
      document.addEventListener('click', function (e) {
        var a = e.target && e.target.closest && e.target.closest('a[data-lang]');
        if (!a) return;
        try {
          localStorage.setItem('sz:lang', a.dataset.lang);
        } catch (err) {}
      });
    </script>
    </div>
  </body>
</html>
